# Copy to web/.env.local and fill in. Never commit web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
# true = serve mock data (contracts/mocks and contracts/draft/mocks). false = call the real API.
NEXT_PUBLIC_USE_MOCKS=true
# true = persona picker instead of Google sign-in. Pitches only; needs NEXT_PUBLIC_USE_MOCKS=true.
NEXT_PUBLIC_DEMO_MODE=false
# How long mock calls take, in milliseconds (default 600).
NEXT_PUBLIC_MOCK_DELAY_MS=600
# Not needed in demo mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
